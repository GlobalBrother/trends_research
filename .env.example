# ============================================================================
# Trends Research System — Environment Variables
# ============================================================================
# Copy this file to .env and fill in your values.
# Run 'python -m src.db.doctor' to verify your database connection.
# Run 'python -m src.db.connection --setup' for a guided setup wizard.

# ============================================================================
# DATABASE — Choose ONE of the three options below
# ============================================================================

# --- Option A: Full connection string (paste from Azure Portal) ---
# Go to: Azure Portal → SQL Database → Connection strings → ADO.NET
# The system auto-converts ADO.NET format to ODBC — just paste as-is.
# AZURE_SQL_CONNECTIONSTRING=Server=tcp:yourserver.database.windows.net,1433;Initial Catalog=YourDB;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;Authentication="Active Directory Default";

# --- Option B: Individual vars with SQL Authentication ---
# AZURE_SQL_SERVER=yourserver.database.windows.net
# AZURE_SQL_DATABASE=YourDB
# AZURE_SQL_USER=youradmin
# AZURE_SQL_PASS=yourpassword

# --- Option C: Individual vars with Azure AD (passwordless) ---
# Requires: az login (or Managed Identity on Azure)
# AZURE_SQL_SERVER=yourserver.database.windows.net
# AZURE_SQL_DATABASE=YourDB

# --- Advanced pool tuning (optional) ---
# DB_POOL_SIZE=10
# DB_POOL_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=120         # Must be > CONNECT_TIMEOUT for serverless resume
# DB_POOL_RECYCLE=300
# DB_CONNECT_TIMEOUT=90       # Azure SQL serverless can take 30-60s to resume
# DB_ENGINE_RETRIES=5
# AZURE_SQL_DRIVER=ODBC Driver 18 for SQL Server

# ============================================================================
# API / Backend
# ============================================================================
BACKEND_URL=http://127.0.0.1:8000
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS (comma-separated origins; * for all)
CORS_ORIGINS=*

# Cache TTL in seconds
CACHE_TTL_SECONDS=300

# ============================================================================
# API Keys (Optional but recommended for full functionality)
# ============================================================================
# Obtain from https://newsapi.org/
NEWS_API_KEY=your_news_api_key_here

# EnsembleData (for TikTok, Instagram, Threads scraping)
# ENSEMBLEDATA_TOKEN=your_token_here

# GetHookdAI (for ads insight scraping)
# GETHOOKEDAI_TOKEN=your_token_here

# Azure Communication Services (for OTP email delivery)
# Create an ACS resource + Email Communication Service in Azure, then:
# ACS_CONNECTION_STRING=endpoint=https://<resource>.communication.azure.com/;accesskey=...
# ACS_SENDER_ADDRESS=DoNotReply@<your-id>.azurecomm.net

# ============================================================================
# Scrapy Settings
# ============================================================================
SCRAPY_CONCURRENT_REQUESTS=1
SCRAPY_DOWNLOAD_DELAY=10
SCRAPY_AUTOTHROTTLE_ENABLED=True
SCRAPE_FRESHNESS_HOURS=144

# Comma-separated list of proxies (optional)
SCRAPY_PROXIES=

# ============================================================================
# Runtime Environment
# ============================================================================
# Valid values: development, dev, staging, production, prod
# When ENV is "production" or "prod", the API refuses to start if
# TEST_ACCOUNT_EMAIL is set (the dev-only OTP bypass must be disabled in prod).
ENV=development

# ============================================================================
# Analytics
# ============================================================================
CLUSTER_THRESHOLD=0.7
DEFAULT_N_CLUSTERS=5

# ============================================================================
# Test Account (development only — bypasses OTP)
# ============================================================================
# TEST_ACCOUNT_EMAIL=test@trends.local
# TEST_ACCOUNT_OTP=000000

# ============================================================================
# Trends Collection V2 (multi-provider pipeline)
# See docs/superpowers/specs/2026-04-23-trends-collection-redesign-design.md §9
# ============================================================================

# Master feature flag — when false (default), the legacy /scrape path is used.
TRENDS_V2_ENABLED=false

# Provider selection
# Comma-separated, ordered. Any provider listed here must have its credentials
# below; missing credentials cause the provider to be silently skipped (with a
# warning at startup). Keep at least two paid providers ahead of legacy_scrapy.
TRENDS_PROVIDER_CHAIN=serpapi,searchapi,brightdata,apify,legacy_scrapy
TRENDS_MONTHLY_BUDGET_USD=150
TRENDS_MAX_CONCURRENT_KEYWORDS_PER_JOB=8
TRENDS_WARMUP_ENABLED=false
TRENDS_WARMUP_GEOS=US,UK,DE
TRENDS_WARMUP_FRESHNESS_HOURS=18
TRENDS_WARMUP_TOP_N=50
# Override the chain for the warmup job (latency-tolerant, prefer cheap bulk).
TRENDS_WARMUP_PROVIDER_CHAIN=apify,searchapi,legacy_scrapy

# SerpAPI (Tier-1 primary)
SERPAPI_KEY=
SERPAPI_MONTHLY_CAP_USD=60

# SearchAPI.io (Tier-1 failover)
SEARCHAPI_KEY=
SEARCHAPI_MONTHLY_CAP_USD=40

# Bright Data SERP API (Tier-2; optional — leave blank to disable)
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_ZONE=serp_api1
BRIGHTDATA_MONTHLY_CAP_USD=30

# Oxylabs SERP Scraper API (Tier-2; interchangeable with Bright Data)
OXYLABS_USERNAME=
OXYLABS_PASSWORD=
OXYLABS_MONTHLY_CAP_USD=30

# Apify (warmup / bulk)
APIFY_TOKEN=
APIFY_TRENDS_ACTOR=emastra/google-trends-scraper
APIFY_MONTHLY_CAP_USD=20

# BigQuery seed (warmup keyword discovery, free at our volume)
BIGQUERY_TRENDS_ENABLED=false
GOOGLE_APPLICATION_CREDENTIALS=

# (Per-provider caps above must sum to <= TRENDS_MONTHLY_BUDGET_USD.)

# Queue / streaming
REDIS_URL=redis://localhost:6379/0
ARQ_MAX_JOBS=4
ARQ_CONCURRENT_KEYWORDS_PER_JOB=8
